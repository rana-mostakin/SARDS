# ============================================================
# SARDS — .gitignore
# ============================================================

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
*.whl

# ── Virtual Environments ───────────────────────────────────────
venv/
.venv/
env/
ENV/
.env

# ── Environment variables ──────────────────────────────────────
.env
.env.local
.env.*.local
secrets.yaml

# ── Jupyter Notebooks ──────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Generated Data (too large for git) ────────────────────────
data/dhaka/*.jpg
data/dhaka/*.tif
data/dhaka/*.tiff
data/dhaka/*.png
data/processed/

# ── Generated Results (reproducible, don't commit) ────────────
results/heatmaps/*.png
results/time_series/*.png
results/time_series/*.csv
results/reports/*.txt
results/reports/*.pdf
results/reports/*.png
results/sards.log

# Keep directory structure
!results/heatmaps/.gitkeep
!results/time_series/.gitkeep
!results/reports/.gitkeep
!data/dhaka/.gitkeep

# ── OS Files ───────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ───────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Testing ────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.coveragerc

# ── Documentation builds ───────────────────────────────────────
docs/_build/
site/

# ── Streamlit ──────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Rasterio / GDAL ───────────────────────────────────────────
*.aux.xml
*.ovr
*.qmd
